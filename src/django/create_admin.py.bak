#!/usr/bin/env python
import os
import sys
import django

# Add the project directory to the path
sys.path.insert(0, '/home/moritz/Projects/python_mailconveyor/src/django')

# Setup Django
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'mailconveyor.settings')
django.setup()

from django.contrib.auth import get_user_model

User = get_user_model()

# Create admin user
try:
    user = User.objects.create_superuser(
        email='admin@example.com',
        first_name='Admin',
        last_name='User',
        password='admin123'
    )
    print(f"✅ Created admin user: {user.email} with role: {user.get_role_display()}")
    print(f"   Password: admin123")
except Exception as e:
    print(f"❌ Error creating admin user: {e}")
    sys.exit(1)