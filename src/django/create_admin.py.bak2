#!/usr/bin/env python
import os
import sys
import django

# Add the project directory to the path
sys.path.insert(0, '/home/moritz/Projects/python_mailconveyor/src/django')

# Setup Django
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'mailconveyor.settings')
django.setup()

from django.contrib.auth.models import User, Group

# Create default groups
for role in ['Admin', 'Manager', 'User']:
    Group.objects.get_or_create(name=role)

# Create admin user
try:
    user = User.objects.create_superuser(
        username='admin',
        email='admin@example.com',
        password='admin123',
        first_name='Admin',
        last_name='User'
    )
    # Add to Admin group
    admin_group = Group.objects.get(name='Admin')
    user.groups.add(admin_group)
    print(f"✅ Created admin user: {user.username} ({user.email})")
    print(f"   Role: {admin_group.name}")
    print(f"   Password: admin123")
except Exception as e:
    print(f"❌ Error creating admin user: {e}")
    sys.exit(1)